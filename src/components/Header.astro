---
interface NavItem {
  href: string;
  label: string;
}

const nav: NavItem[] = [
  { href: "/", label: "Inicio" },
  { href: "/equipos", label: "Equipos" },
  { href: "/calendario", label: "Calendario" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="absolute top-0 left-0 w-full z-20">
  <div class="container mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3">
      <img src="/android-chrome-512x512.png" alt="CV Martorell" class="w-10 h-10 md:w-12 md:h-12"/>
      <span class="text-white font-bold text-xl">CV Martorell</span>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Navegación principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-white/90 hover:text-white transition-colors px-1 py-1
                 focus:outline-none focus:ring-2 focus:ring-white/60"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Botón menú móvil -->
    <button
      id="menuToggle"
      class="md:hidden text-white focus:outline-none focus:ring-2 focus:ring-white/60"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <div
    id="mobileMenu"
    class="md:hidden hidden flex-col bg-black/70 backdrop-blur border-t border-white/20 px-6 py-4"
  >
    {nav.map((item) => (
      <a
        href={item.href}
        class="block py-3 text-white/90 hover:text-white transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>

  <script is:inline>
    const btn = document.getElementById('menuToggle');
    const menu = document.getElementById('mobileMenu');
    btn?.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(open));
    });
  </script>
</header>