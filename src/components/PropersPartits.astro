---
// ProperPartits.astro  — faldó ticker estil ESPN

const WORKER_URL = "https://cv-martorell-worker.informatica-179.workers.dev";

const SLUGS_EQUIPS = [
  "alevi-mixt",
  "infantil-masculi-negre",
  "infantil-femeni-negre",
  "infantil-femeni-blau",
  "infantil-femeni-vermell",
  "cadet-femeni-negre",
  "cadet-femeni-blau",
  "juvenil-femeni-negre",
  "juvenil-femeni-blau",
  "junior-femeni-negre",
  "senior-femeni-negre",
  "senior-femeni-blau",
];

type ProperPartit = {
  local: string;
  visitant: string;
  data: string;
  slug: string;
};

let partits: ProperPartit[] = [];
let error: string | null = null;

try {
  const responses = await Promise.all(
    SLUGS_EQUIPS.map(async (slug) => {
      const res = await fetch(`${WORKER_URL}/equip/${slug}`);
      if (!res.ok) return null;
      const data = await res.json();
      const proper = data?.propersPartits?.[0];
      if (!proper) return null;
      return { local: proper.local, visitant: proper.visitant, data: proper.data, slug };
    })
  );
  partits = responses
    .filter(Boolean)
    .sort((a, b) => new Date(a!.data).getTime() - new Date(b!.data).getTime())
    .slice(0, 8) as ProperPartit[];
} catch {
  error = "No s'han pogut carregar els propers partits.";
}

function formatData(data: string) {
  if (!data) return "—";
  const d = new Date(data);
  if (isNaN(d.getTime())) return data.trim();
  return d.toLocaleString("ca-ES", {
    weekday: "short", day: "2-digit", month: "short",
    hour: "2-digit", minute: "2-digit",
  });
}
---

<!-- Ticker: fons clar (section-light) amb etiqueta oscura -->
<div class="ticker-root section-light border-y border-brand-light/30 overflow-hidden">
  <div class="relative flex items-center h-11">

    <!-- Etiqueta -->
    <div class="ticker-label section-hero flex items-center gap-2 px-4 h-full flex-shrink-0
                font-extrabold uppercase tracking-widest text-xs">
      <span class="block w-2.5 h-2.5 bg-accent-yellow rounded-sm"></span>
      Propers partits
    </div>

    <!-- Contingut del scroll -->
    <div class="flex-1 overflow-hidden h-full flex items-center">
      {error && (
        <span class="px-6 text-ui-textMuted text-sm">{error}</span>
      )}
      {!error && partits.length === 0 && (
        <span class="px-6 text-ui-textMuted text-sm">No hi ha partits programats</span>
      )}
      {!error && partits.length > 0 && (
        <div class="flex items-center gap-8 px-6 animate-marquee whitespace-nowrap">
          {partits.map((p) => (
            <div class="flex items-center gap-3">
              <a href={`/equips/${p.slug}`}
                 class="ticker-link text-sm font-semibold hover:underline">
                {p.local}
                <span class="text-ui-textMuted mx-1">vs</span>
                {p.visitant}
              </a>
              <span class="text-ui-textMuted text-xs">{formatData(p.data)}</span>
              <span class="ticker-divider">│</span>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</div>

<style>
  .ticker-root { background: var(--bg-muted); }

  /* L'etiqueta reutilitza section-hero però amb mida compacta */
  .ticker-label {
    background: var(--brand-dark);
    color: var(--accent-yellow);
  }

  .ticker-link  { color: var(--text-primary); }
  .ticker-divider { color: var(--text-muted); }
</style>