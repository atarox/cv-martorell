---
interface Sponsor {
  name: string;
  logo: string;
  url: string;
  tier: "or" | "plata" | "bronze" | "col·laborador";
  alt?: string;
}

const sponsors: Sponsor[] = [
  { name: "Maipizza",   logo: "/images/sponsors/sponsor1.png", url: "#", tier: "or",            alt: "Maipizza, patrocinador or" },
  { name: "La Secre",   logo: "/images/sponsors/sponsor2.png", url: "#", tier: "plata",         alt: "La Secre, patrocinador plata" },
  { name: "El Cortijo", logo: "/images/sponsors/sponsor4.png", url: "#", tier: "bronze",        alt: "El Cortijo, patrocinador bronze" },
  { name: "Sanjo",      logo: "/images/sponsors/sponsor3.png", url: "#", tier: "col·laborador", alt: "Sanjo, col·laborador" },
];

const or           = sponsors.filter(s => s.tier === "or");
const plata        = sponsors.filter(s => s.tier === "plata");
const bronze       = sponsors.filter(s => s.tier === "bronze");
const colaboradors = sponsors.filter(s => s.tier === "col·laborador");
---

<section class="relative py-24 overflow-hidden bg-ui-bg" aria-labelledby="patrocinadors">

  <!-- Fons: malla de punts subtil -->
  <div class="absolute inset-0 opacity-[0.06]"
       style="background-image: radial-gradient(circle, #0D1C23 1px, transparent 1px); background-size: 32px 32px;"></div>

  <div class="relative max-w-6xl mx-auto px-6">

    <!-- Capçalera -->
    <div class="text-center mb-16 sponsor-reveal">
      <p class="text-secondary-blue text-xs font-bold uppercase tracking-[0.3em] mb-3">Els qui fan possible el club</p>
      <h2 id="patrocinadors" class="text-3xl md:text-5xl font-extrabold text-brand-dark tracking-tight">
        Patrocinadors
      </h2>
      <div class="mt-4 mx-auto w-12 h-0.5 bg-gradient-to-r from-transparent via-secondary-blue to-transparent"></div>
    </div>

    <!-- OR: blanc amb accent daurat, visible sobre fons clar -->
    {or.length > 0 && (
      <div class="mb-16 sponsor-reveal">
        <ul class={`grid gap-4 ${or.length === 1 ? 'grid-cols-1 max-w-md mx-auto' : 'grid-cols-1 sm:grid-cols-2'}`}>
          {or.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 class="sponsor-or group relative flex items-center justify-center rounded-3xl overflow-hidden
                        bg-white border-2 border-catalan-yellow/40 shadow-lg
                        hover:shadow-xl hover:border-catalan-yellow/80
                        transition-all duration-500 focus:outline-none focus:ring-2 focus:ring-catalan-yellow/40"
                 style="min-height: 180px;"
                 aria-label={s.name}>

                <!-- Línia or superior -->
                <div class="absolute top-0 left-0 right-0 h-1 rounded-t-3xl"
                     style="background: linear-gradient(90deg, transparent, #F2CB40, transparent);"></div>

                <!-- Glow daurat subtil de fons -->
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-3xl"
                     style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(242,203,64,0.08) 0%, transparent 70%);"></div>

                <!-- BADGE -->
                <div class="absolute top-3 right-3 z-20 flex items-center gap-1.5
                            rounded-full px-3 py-1 bg-catalan-yellow/15 border border-catalan-yellow/40">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 text-catalan-yellow" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="text-[10px] font-bold uppercase tracking-widest text-catalan-yellow">Patrocinador Oficial</span>
                </div>

                <!-- Partícules -->
                <div class="particles absolute inset-0 pointer-events-none overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="particle"></span><span class="particle"></span><span class="particle"></span>
                  <span class="particle"></span><span class="particle"></span>
                </div>

                <img src={s.logo} alt={s.alt || s.name}
                     class="relative z-10 object-contain w-full max-h-28 px-12
                            opacity-90 group-hover:opacity-100 group-hover:scale-105
                            transition-all duration-500"
                     loading="lazy" />

                <span class="absolute bottom-3 left-0 right-0 text-center text-[11px] font-semibold uppercase tracking-widest
                             text-brand-dark/30 group-hover:text-brand-dark/60 transition-colors duration-300">
                  {s.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- PLATA: blanc amb vora visible -->
    {plata.length > 0 && (
      <div class="mb-10 sponsor-reveal">
        <ul class={`grid gap-3 ${plata.length <= 2 ? 'grid-cols-2 max-w-lg mx-auto' : 'grid-cols-2 md:grid-cols-3'}`}>
          {plata.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 class="group relative flex items-center justify-center rounded-2xl overflow-hidden
                        bg-white border border-brand-dark/12
                        hover:border-secondary-blue/40 hover:shadow-md
                        transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-secondary-blue/30"
                 style="min-height: 120px;"
                 aria-label={s.name}>
                <div class="absolute top-0 left-0 right-0 h-px"
                     style="background: linear-gradient(90deg, transparent, #CBD5E1, transparent);"></div>
                <img src={s.logo} alt={s.alt || s.name}
                     class="object-contain w-full max-h-16 px-8
                            opacity-75 group-hover:opacity-100 group-hover:scale-105
                            transition-all duration-300"
                     loading="lazy" />
                <span class="absolute bottom-2 left-0 right-0 text-center text-[10px] font-semibold uppercase tracking-widest
                             text-brand-dark/30 group-hover:text-brand-dark/60 transition-colors duration-300">
                  {s.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- BRONZE: blanc amb vora més lleugera -->
    {bronze.length > 0 && (
      <div class="mb-10 sponsor-reveal">
        <ul class={`grid gap-3 ${bronze.length <= 3 ? 'grid-cols-3 max-w-xl mx-auto' : 'grid-cols-2 md:grid-cols-4'}`}>
          {bronze.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 class="group relative flex items-center justify-center rounded-xl overflow-hidden
                        bg-white border border-brand-dark/10
                        hover:border-brand-dark/25 hover:shadow-sm
                        transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-dark/20"
                 style="min-height: 90px;"
                 aria-label={s.name}>
                <div class="absolute top-0 left-0 right-0 h-px opacity-60"
                     style="background: linear-gradient(90deg, transparent, #C97C3A, transparent);"></div>
                <img src={s.logo} alt={s.alt || s.name}
                     class="object-contain w-full max-h-12 px-6
                            opacity-65 group-hover:opacity-100 group-hover:scale-105
                            transition-all duration-300"
                     loading="lazy" />
                <span class="absolute bottom-1.5 left-0 right-0 text-center text-[9px] font-semibold uppercase tracking-widest
                             text-brand-dark/25 group-hover:text-brand-dark/55 transition-colors duration-300">
                  {s.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- COL·LABORADORS: franja marquee -->
    {colaboradors.length > 0 && (
      <div class="mb-10 sponsor-reveal">
        <div class="flex items-center gap-4 mb-5">
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, rgba(43,110,127,0.25), transparent);"></div>
          <span class="text-secondary-blue/60 text-[10px] font-bold uppercase tracking-[0.3em] whitespace-nowrap">
            Col·laboradors del club
          </span>
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, rgba(43,110,127,0.25), transparent);"></div>
        </div>

        <div class="relative overflow-hidden marquee-outer">
          <ul class="flex w-max animate-marquee hover:[animation-play-state:paused]">
            {[...colaboradors, ...colaboradors].map((s, i) => (
              <li key={i}>
                <a href={s.url} target="_blank" rel="noopener noreferrer"
                   aria-label={s.name}
                   class="flex items-center justify-center h-16 px-8 min-w-[120px]
                          border-r border-brand-dark/[0.08]
                          opacity-50 hover:opacity-100
                          transition-opacity duration-300">
                  <img src={s.logo} alt={s.alt || s.name}
                       class="object-contain max-h-8 max-w-[100px]"
                       loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

  </div>
</section>

<style>
  .marquee-outer::before,
  .marquee-outer::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .marquee-outer::before {
    left: 0;
    background: linear-gradient(90deg, #E2F4FB, transparent);
  }
  .marquee-outer::after {
    right: 0;
    background: linear-gradient(-90deg, #E2F4FB, transparent);
  }

  .particle {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #F2CB40;
    animation: float-particle 3s ease-in-out infinite;
    opacity: 0;
  }
  .particle:nth-child(1) { left: 20%; top: 70%; animation-delay: 0s;   animation-duration: 2.8s; }
  .particle:nth-child(2) { left: 40%; top: 80%; animation-delay: 0.4s; animation-duration: 3.2s; }
  .particle:nth-child(3) { left: 60%; top: 75%; animation-delay: 0.8s; animation-duration: 2.5s; }
  .particle:nth-child(4) { left: 75%; top: 65%; animation-delay: 1.2s; animation-duration: 3.5s; }
  .particle:nth-child(5) { left: 85%; top: 55%; animation-delay: 0.2s; animation-duration: 2.9s; }

  @keyframes float-particle {
    0%   { transform: translateY(0) scale(0);    opacity: 0; }
    20%  { opacity: 0.6; }
    80%  { opacity: 0.3; }
    100% { transform: translateY(-60px) scale(1.5); opacity: 0; }
  }

  .sponsor-or::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(135deg, transparent 30%, rgba(242,203,64,0.5), transparent 70%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .sponsor-or:hover::after { opacity: 1; }

  .sponsor-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .sponsor-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script is:inline>
{
  const reveals = document.querySelectorAll('.sponsor-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 120);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  reveals.forEach(el => observer.observe(el));
}
</script>
