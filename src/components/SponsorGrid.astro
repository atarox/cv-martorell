---
interface Sponsor {
  name: string;
  logo: string;
  url: string;
  tier: "principal" | "colaborador" | "amic";
  alt?: string;
}

const sponsors: Sponsor[] = [
  { name: "Maipizza", logo: "/images/sponsors/sponsor1.png", url: "#", tier: "principal", alt: "Maipizza, patrocinador principal" },
  { name: "La Secre", logo: "/images/sponsors/sponsor2.png", url: "#", tier: "colaborador", alt: "La Secre, patrocinador col·laborador" },
  { name: "Sanjo", logo: "/images/sponsors/sponsor3.png", url: "#", tier: "amic", alt: "Sanjo, patrocinador amic" },
  { name: "El Cortijo", logo: "/images/sponsors/sponsor4.png", url: "#", tier: "colaborador", alt: "El Cortijo, patrocinador col·laborador" },
];

const principals = sponsors.filter((s) => s.tier === "principal");
const colaboradors = sponsors.filter((s) => s.tier === "colaborador");
const amics = sponsors.filter((s) => s.tier === "amic");
---

<section class="py-16 bg-ui-bg">
  <div class="max-w-6xl mx-auto px-6">
    
    {/** Principals */}
    {principals.length > 0 && (
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-12">
        {principals.map((s) => (
          <li class="group">
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-2xl bg-white/50 backdrop-blur-sm border border-brand-light/30
                     shadow-lg hover:shadow-2xl transform hover:-translate-y-1 hover:scale-105
                     transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-brand-light/40"
              aria-label={`Obrir el lloc de ${s.name} (s'obre en nova pestanya)`}
            >
              <div class="p-6 flex items-center justify-center">
                <img src={s.logo} alt={s.alt || s.name} class="object-contain w-full max-h-28" loading="lazy" />
              </div>
              <div class="px-6 pb-6 -mt-2">
                <div class="rounded-xl bg-brand-dark text-white text-center px-4 py-2 font-medium">
                  Patrocinador principal
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    {/** Col·laboradors */}
    {colaboradors.length > 0 && (
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-12">
        {colaboradors.map((s) => (
          <li class="group">
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-xl bg-white/40 backdrop-blur-sm border border-brand-light/20
                     shadow-md hover:shadow-lg transform hover:-translate-y-1 hover:scale-105
                     transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-brand-light/30"
              aria-label={`Obrir el lloc de ${s.name} (s'obre en nova pestanya)`}
            >
              <div class="p-5 flex items-center justify-center">
                <img src={s.logo} alt={s.alt || s.name} class="object-contain w-full max-h-20" loading="lazy" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    {/** Amics */}
    {amics.length > 0 && (
      <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
        {amics.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-lg bg-white/30 backdrop-blur-sm border border-brand-light/20
                     shadow-md hover:shadow-lg transform hover:-translate-y-0.5 hover:scale-105
                     transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-brand-light/20"
              aria-label={`Obrir el lloc de ${s.name} (s'obre en nova pestanya)`}
            >
              <div class="p-3 flex items-center justify-center">
                <img src={s.logo} alt={s.alt || s.name} class="object-contain w-full max-h-12" loading="lazy" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

  </div>
</section>