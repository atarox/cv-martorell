---
interface Props {
  fromColor?: string;
  toColor?: string;
  accent?: string;
  flip?: boolean;
}

const {
  fromColor = "#0D1C23",
  toColor = "#0D1C23",
  accent = "#76AFC2",
  flip = false,
} = Astro.props;
---

<div
  class="relative w-full overflow-hidden"
  style={`background: linear-gradient(to bottom, ${fromColor} 50%, ${toColor} 50%); height: 95px;`}
>
  <svg
    viewBox="0 0 1200 95"
    preserveAspectRatio="xMidYMid meet"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full"
    style={flip ? "transform: scaleX(-1);" : ""}
  >

    <defs>
      <filter id="shadow">
        <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-opacity="0.25"/>
      </filter>
    </defs>

    <!-- red -->
    <path
      d="M0 50 Q600 62 1200 50"
      fill="none"
      stroke={accent}
      stroke-width="2"
      stroke-opacity="0.65"
    />

    <!-- malla simplificada -->
    <g stroke={accent} stroke-opacity="0.12" stroke-width="1">
      <line x1="0" y1="68" x2="1200" y2="68"/>
      <line x1="300" y1="52" x2="300" y2="68"/>
      <line x1="600" y1="55" x2="600" y2="68"/>
      <line x1="900" y1="52" x2="900" y2="68"/>
    </g>

    <!-- balón -->
    <g transform="translate(600 42)" class="ball" filter="url(#shadow)">

      <circle
        r="18"
        fill={fromColor}
        stroke={accent}
        stroke-width="1.4"
      />

      <path d="M-12,-4 Q0,-16 12,-4"
        fill="none"
        stroke={accent}
        stroke-width="1.1"
        stroke-linecap="round"/>

      <path d="M-14,5 Q0,-4 14,5"
        fill="none"
        stroke={accent}
        stroke-width="1.1"
        stroke-linecap="round"/>

      <path d="M-8,13 Q0,2 8,13"
        fill="none"
        stroke={accent}
        stroke-width="1.1"
        stroke-linecap="round"/>

      <circle cx="-5" cy="-6" r="2.5" fill="white" opacity="0.15"/>

    </g>

  </svg>
</div>

<style>

.ball {
  animation: ballFloat 4s ease-in-out infinite;
  transform-origin: center;
}

@keyframes ballFloat {

  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5px);
  }

}

</style>