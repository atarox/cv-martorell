---
interface Props {
  fromColor?: string;
  toColor?: string;
  accent?: string;
  flip?: boolean;
}
const {
  fromColor = "#0D1C23",
  toColor   = "#0D1C23",
  accent    = "#76AFC2",
  flip      = false,
} = Astro.props;
---

<div
  class="relative w-full overflow-hidden"
  style={`height: 100px; background: linear-gradient(to bottom, ${fromColor} 50%, ${toColor} 50%);`}
>

  <!-- Red (SVG, s'estira al 100% sense distorsionar el balón) -->
  <svg
    viewBox="0 0 1200 100"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute inset-0 w-full h-full"
    style={flip ? "transform: scaleX(-1);" : ""}
    aria-hidden="true"
  >
    <!-- Postes -->
    <rect x="0"    y="28" width="5" height="55" fill={accent} opacity="0.5" rx="1"/>
    <rect x="1195" y="28" width="5" height="55" fill={accent} opacity="0.5" rx="1"/>

    <!-- Corda superior corbada -->
    <path class="net-top"
          d="M5 48 Q300 44 600 48 Q900 52 1195 48"
          fill="none"
          stroke={accent}
          stroke-width="2.5"
          stroke-opacity="0.85"/>

    <!-- Malla vertical: 14 línies distribuïdes -->
    <g stroke={accent} stroke-opacity="0.18" stroke-width="1">
      <line x1="80"   y1="55" x2="80"   y2="82"/>
      <line x1="160"  y1="53" x2="160"  y2="82"/>
      <line x1="240"  y1="51" x2="240"  y2="82"/>
      <line x1="320"  y1="49" x2="320"  y2="82"/>
      <line x1="400"  y1="48" x2="400"  y2="82"/>
      <line x1="480"  y1="48" x2="480"  y2="82"/>
      <line x1="560"  y1="48" x2="560"  y2="82"/>
      <line x1="640"  y1="48" x2="640"  y2="82"/>
      <line x1="720"  y1="48" x2="720"  y2="82"/>
      <line x1="800"  y1="48" x2="800"  y2="82"/>
      <line x1="880"  y1="49" x2="880"  y2="82"/>
      <line x1="960"  y1="51" x2="960"  y2="82"/>
      <line x1="1040" y1="53" x2="1040" y2="82"/>
      <line x1="1120" y1="55" x2="1120" y2="82"/>
    </g>

    <!-- Malla horitzontal -->
    <line x1="5" y1="65" x2="1195" y2="65" stroke={accent} stroke-opacity="0.10" stroke-width="1"/>
    <line x1="5" y1="82" x2="1195" y2="82" stroke={accent} stroke-opacity="0.14" stroke-width="1"/>
  </svg>

  <!-- Ombra del balón (element HTML independent) -->
  <div class="ball-shadow" aria-hidden="true"></div>

  <!-- Balón SVG (fora del SVG de la xarxa per no distorsionar-se) -->
  <div class="ball-group" aria-hidden="true">
    <svg width="44" height="44" viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
      <!-- Cos del balón -->
      <circle cx="22" cy="22" r="19" fill={fromColor} stroke={accent} stroke-width="2"/>
      <!-- Línies de volei -->
      <path d="M6 14 Q22 8 38 14"  fill="none" stroke={accent} stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>
      <path d="M4 22 Q22 16 40 22" fill="none" stroke={accent} stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>
      <path d="M6 30 Q22 24 38 30" fill="none" stroke={accent} stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>
      <!-- Meridians verticals -->
      <path d="M22 3 Q30 22 22 41" fill="none" stroke={accent} stroke-width="1" stroke-opacity="0.4"/>
      <path d="M22 3 Q14 22 22 41" fill="none" stroke={accent} stroke-width="1" stroke-opacity="0.4"/>
      <!-- Brillantor -->
      <circle cx="14" cy="13" r="4" fill="white" opacity="0.12"/>
    </svg>
  </div>

</div>

<style>
  /* Arc de parábola: d'esquerra a dreta passant per sobre de la xarxa */
  @keyframes ballArc {
    0%   { transform: translate(-60px,  32px) rotate(-15deg); }
    40%  { transform: translate(calc(50vw - 22px), -14px) rotate(8deg); }
    100% { transform: translate(calc(100vw + 60px), 30px) rotate(25deg); }
  }

  @keyframes shadowArc {
    0%   { transform: translateX(-60px)              scaleX(0.5); opacity: 0.10; }
    40%  { transform: translateX(calc(50vw - 18px))  scaleX(1.0); opacity: 0.28; }
    100% { transform: translateX(calc(100vw + 60px)) scaleX(0.5); opacity: 0.08; }
  }

  /* Petita vibració de la xarxa quan el balón la passa */
  @keyframes netShiver {
    0%,100% { transform: translateY(0); }
    20%     { transform: translateY(-1.5px); }
    40%     { transform: translateY(0.6px); }
    60%     { transform: translateY(-0.8px); }
  }

  .ball-group {
    position: absolute;
    top: 0;
    left: 0;
    animation: ballArc 3.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    will-change: transform;
  }

  .ball-shadow {
    position: absolute;
    bottom: 10px;
    left: 0;
    width: 36px;
    height: 8px;
    background: rgba(0, 0, 0, 0.28);
    border-radius: 50%;
    filter: blur(3px);
    animation: shadowArc 3.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    will-change: transform;
  }

  .net-top {
    animation: netShiver 3.4s ease-in-out infinite;
    transform-origin: center bottom;
  }
</style>