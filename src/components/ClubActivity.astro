---
/**
 * ClubActivity.astro
 * Instagram oficial del club (sin scraping)
 */
---

<section class="relative pt-16 pb-32 bg-ui-bg">
  <div class="max-w-6xl mx-auto px-6">

    <h2
      id="el-club-esta-vivo"
      class="text-3xl font-bold text-brand-dark mb-1 tracking-tight"
    >
      Entrenem. Competim. Creixem.
    </h2>

    <p class="text-ui-text mb-8">
      Últims partits i moments del club.
    </p>

    <!-- Instagram embed -->
    <div class="rounded-xl overflow-hidden bg-white/70 shadow-soft p-4 flex justify-center">

      <iframe
        src="https://www.instagram.com/clubvoleimartorell/embed"
        class="w-full max-w-xl"
        height="600"
        frameborder="0"
        scrolling="no"
        allowtransparency="true"
      ></iframe>

    </div>

    <!-- CTA Instagram -->
    <div class="text-center mt-8">
      <a
        href="https://instagram.com/clubvoleimartorell"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-pill bg-brand-dark text-white px-6 py-3
               shadow-soft hover:bg-secondary-blue transition-colors
               focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-dark"
      >
        Segueix-nos a Instagram
      </a>
    </div>

  </div>
</section>