---
/**
 * Footer.astro – Premium edition
 * - Tipografia més marcada i CTA destacats
 * - Botons amb hover i transició
 * - Icones socials reals i interactives
 * - Accessibilitat i SEO intactes
 */

const year = new Date().getFullYear();

const navLinks = [
  { href: "/equips", label: "Equips" },
  { href: "/club", label: "El Club" },
  { href: "/socis", label: "Socis" },
  { href: "/contacte", label: "Contacte" },
    { href: "/historia", label: "Historia" },
];

const policyLinks = [
  { href: "/legal", label: "Privacitat" },
  { href: "/cookies", label: "Cookies" },
];

const socials = [
  { href: "https://instagram.com/clubvoleimartorell", label: "Instagram", icon: "instagram" },
  { href: "https://facebook.com/100064042807493/", label: "Facebook", icon: "facebook" },
];
---

<footer class="mt-16 bg-brand-dark text-white">

  <!-- Banda superior amb CTA patrocinis -->
  <div class="container mx-auto px-6 py-8 backdrop-blur-sm rounded-xl shadow-lg">
    <div class="md:flex md:items-center md:justify-between gap-6">
      <div class="md:max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">
          Vols impulsar el vòlei a Martorell?
        </h2>
        <p class="mt-2 text-white/80">
          Uneix-te com a patrocinador: visibilitat local i digital, presència a equips i esdeveniments.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex gap-3">
        <a
          href="/docs/dossier-patrocinadors.pdf"
          class="inline-flex items-center justify-center rounded-pill bg-white text-brand-dark px-5 py-2.5
                 border border-white/20 hover:bg-ui-bg hover:scale-105 transition-transform transition-colors duration-300
                 focus:outline-none focus:ring-2 focus:ring-white/40 shadow-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Descarregar dossier
        </a>
        <a
          href="/contacte"
          class="inline-flex items-center justify-center rounded-pill bg-brand-light text-brand-dark px-5 py-2.5
                 hover:bg-white hover:scale-105 transition-transform transition-colors duration-300
                 focus:outline-none focus:ring-2 focus:ring-white/40 shadow-lg"
        >
          Contactar
        </a>
      </div>
    </div>
  </div>

  <!-- Contingut inferior: columnes i xarxes -->
  <div class="container mx-auto px-6 py-10 grid md:grid-cols-3 gap-8">
    <!-- Columna: identitat i contacte -->
    <div>
      <div class="flex items-center gap-3 mb-4">
        <img src="/logo.png" alt="CV Martorell" class="h-10" />
        <span class="text-lg md:text-xl font-semibold">CV Martorell</span>
      </div>
      <address class="not-italic text-white/80 mb-4">
        Pavelló Municipal Can Cases<br />
        Carrer Josep Vilar s/n<br />
        08635 Martorell, Barcelona<br />
        <a href="mailto:administracio@clubvoleimartorell.com" class="underline hover:text-brand-light focus:outline-none focus:ring-2 focus:ring-white/40">
          administracio@clubvoleimartorell.com
        </a><br />
        <a href="tel:+34937750050" class="underline hover:text-brand-light focus:outline-none focus:ring-2 focus:ring-white/40">
          +34 937 75 00 50
        </a>
      </address>

      <!-- Xarxes socials amb icones reals -->
      <div class="flex gap-4 mt-2" aria-label="Xarxes socials">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-transform duration-200 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white/40"
            aria-label={s.label}
          >
            {s.icon === "instagram" && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-white hover:text-[#E4405F]">
                <path d="M7.75 2h8.5C19.55 2 22 4.45 22 7.75v8.5C22 19.55 19.55 22 16.25 22h-8.5C4.45 22 2 19.55 2 16.25v-8.5C2 4.45 4.45 2 7.75 2zm0 1.5C5.68 3.5 4 5.18 4 7.25v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 3.5 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm4.75-.88a1.12 1.12 0 1 1 0 2.25 1.12 1.12 0 0 1 0-2.25z"/>
              </svg>
            )}
            {s.icon === "facebook" && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-white hover:text-[#1877F2]">
                <path d="M22 12a10 10 0 1 0-11.5 9.88v-6.99h-2.1V12h2.1V9.79c0-2.07 1.23-3.22 3.12-3.22.9 0 1.84.16 1.84.16v2.02h-1.04c-1.03 0-1.35.64-1.35 1.3V12h2.3l-.37 2.89h-1.93v6.99A10 10 0 0 0 22 12z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Columna: navegació i legal -->
    <nav aria-label="Navegació secundària" class="grid grid-cols-2 gap-x-6">
      <div>
        <h3 class="text-white/90 font-extrabold">Club</h3>
        <ul class="mt-3 space-y-2">
          {navLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-white focus:outline-none focus:ring-2 focus:ring-white/40">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-white/90 font-extrabold">Legal</h3>
        <ul class="mt-3 space-y-2">
          {policyLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-white focus:outline-none focus:ring-2 focus:ring-white/40">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Columna: newsletter -->
    <div>
      <h3 class="text-white/90 font-extrabold">Mantén-te al dia</h3>
      <p class="mt-2 text-white/70">
        Rep novetats, esdeveniments i resultats del club.
      </p>
      <form action="/api/subscribe" method="POST" class="mt-3 flex gap-2">
        <input
          type="email"
          name="email"
          required
          placeholder="tu@email.com"
          class="flex-1 rounded-md bg-white/10 text-white placeholder-white/60 px-3 py-2
                 border border-white/20 focus:outline-none focus:ring-2 focus:ring-white/40"
        />
        <button
          type="submit"
          class="rounded-md bg-brand-light text-brand-dark px-4 py-2 font-medium
                 hover:bg-white hover:scale-105 transition-transform transition-colors duration-300
                 focus:outline-none focus:ring-2 focus:ring-white/40"
        >
          Subscriure'm
        </button>
      </form>
    </div>
  </div>

  <!-- Separador subtil -->
  <div class="h-px bg-white/15"></div>

  <!-- Línia inferior -->
  <div class="container mx-auto px-6 py-6 text-center text-white/70">
    © {year} CV Martorell. Tots els drets reservats.
  </div>

</footer>