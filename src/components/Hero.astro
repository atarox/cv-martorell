---
const title1 = "Blau i negre,";
const title2 = "orgull de Martorell";
const subtitle = "Cantera, competició i compromís al Baix Llobregat";

const slides = [
  { src: "/images/club/accio1.webp", alt: "Remat al partit",    position: "center top",    ken: "zoom-out"  },
  { src: "/images/club/accio2.webp", alt: "Màxima intensitat",  position: "center center", ken: "pan-left"  },
  { src: "/images/club/accio3.webp", alt: "Equip a pista",      position: "center bottom", ken: "pan-right" },
  { src: "/images/club/accio4.webp", alt: "Celebració",         position: "center center", ken: "zoom-in"   },
];
---

<section id="hero" class="relative h-screen min-h-[600px] max-h-[900px] overflow-hidden flex items-end">

  <!-- CARRUSEL KEN BURNS -->
  <div id="hero-carousel" class="absolute inset-0">
    {slides.map((slide, i) => (
      <div
        class="hero-slide absolute inset-0"
        data-index={i}
        data-ken={slide.ken}
        aria-hidden={i !== 0 ? "true" : "false"}
        style={`z-index: ${i === 0 ? 2 : 1}; opacity: ${i === 0 ? 1 : 0};`}
      >
        <img
          src={slide.src}
          alt={slide.alt}
          class="hero-slide-img w-full h-full object-cover will-change-transform"
          style={`object-position: ${slide.position};`}
          fetchpriority={i === 0 ? "high" : "lazy"}
          loading={i === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>

  <!-- GRADIENT CINEMATOGRÀFIC -->
  <div class="absolute inset-0 pointer-events-none" style="z-index:3;
       background:
         linear-gradient(to top,   #0D1C23 0%, #0D1C23cc 25%, transparent 60%),
         linear-gradient(to right, #0D1C2399 0%, transparent 55%),
         linear-gradient(135deg,   #0D1C2340 0%, transparent 60%);"></div>

  <!-- GRAIN -->
  <div class="absolute inset-0 opacity-[0.035] pointer-events-none" style="z-index:4;
       background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23n)%22 opacity=%221%22/></svg>');"></div>

  <!-- FLASH D'ENTRADA -->
  <div id="hero-flash" class="absolute inset-0 pointer-events-none" style="z-index:5;
       background: linear-gradient(105deg, transparent 0%, rgba(118,175,194,0.15) 50%, transparent 100%);
       transform: translateX(-100%);"></div>

  <!-- ENTITATS VINCULADES: cantonada superior dreta, sota el header -->
  <div class="absolute top-20 right-6 flex items-center gap-4" style="z-index:10;">
    <a href="https://www.martorell.cat" target="_blank" rel="noopener noreferrer"
       aria-label="Ajuntament de Martorell"
       class="opacity-70 hover:opacity-80 transition-opacity duration-300">
      <img src="/images/sponsors/ajmartorell.png" alt="Ajuntament de Martorell"
           class="h-20 object-contain drop-shadow-lg" loading="lazy" />
    </a>
    <a href="https://www.fcvolei.cat" target="_blank" rel="noopener noreferrer"
       aria-label="Federació Catalana de Voleibol"
       class="opacity-70 hover:opacity-80 transition-opacity duration-300">
      <img src="/images/sponsors/fcvb.webp" alt="Federació Catalana de Voleibol"
           class="h-20 object-contain drop-shadow-lg" loading="lazy" />
    </a>
  </div>

  <!-- DOTS NAVEGACIÓ -->
  {slides.length > 1 && (
    <div id="hero-dots" class="absolute bottom-8 right-8 flex gap-2" style="z-index:10;">
      {slides.map((_, i) => (
        <button
          class="hero-dot w-1.5 h-1.5 rounded-full transition-all duration-500 focus:outline-none"
          data-dot={i}
          style={i === 0
            ? "background: rgba(118,175,194,1); width: 20px;"
            : "background: rgba(118,175,194,0.35);"}
          aria-label={`Foto ${i + 1}`}
        />
      ))}
    </div>
  )}

  <!-- CONTINGUT -->
  <div class="relative w-full container mx-auto px-6 pb-16 md:pb-20" style="z-index:10;">
    <div class="max-w-4xl">

      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-white leading-[0.95] tracking-tight mb-4">
        <span class="block overflow-hidden pb-3">
          <span id="hero-line1" class="block opacity-0" style="transform: translateY(100%);">
            {title1}
          </span>
        </span>
        <span class="block overflow-hidden pb-3">
          <span id="hero-line2" class="block opacity-0 text-brand-light" style="transform: translateY(100%);">
            {title2}
          </span>
        </span>
      </h1>

      <div id="hero-sub" class="opacity-0 pb-10 md:pb-0" style="transform: translateY(16px);">
        <div class="flex items-center gap-4 mb-3">
          <div class="w-8 h-px bg-brand-light/60"></div>
          <p class="text-white/60 text-sm md:text-base font-medium tracking-wide uppercase">
            {subtitle}
          </p>
        </div>

        <div class="flex gap-6 mt-6">
          {[
            { num: "1975", label: "Fundació", target: 1975, prefix: "",  suffix: "" },
            { num: "+180", label: "Jugadors", target: 180,  prefix: "+", suffix: "" },
            { num: "+18",  label: "Equips",   target: 18,   prefix: "+", suffix: "" },
          ].map(s => (
            <div>
              <p class="text-white font-extrabold text-xl md:text-2xl leading-none stat-number"
                 data-target={s.target}
                 data-prefix={s.prefix}
                 data-suffix={s.suffix}>
                {s.num}
              </p>
              <p class="text-white/40 text-xs mt-0.5 uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- SCROLL INDICATOR -->
  <div id="hero-scroll" class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 opacity-0 flex-col items-center gap-1" style="z-index:10;">
    <span class="text-white/30 text-xs uppercase tracking-[0.2em]">Descobreix</span>
    <div class="w-px h-8 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
  </div>

</section>

<style>
  @keyframes kb-zoom-in {
    from { transform: scale(1.0)  translate(0,   0); }
    to   { transform: scale(1.12) translate(0,   0); }
  }
  @keyframes kb-zoom-out {
    from { transform: scale(1.12) translate(0,   0); }
    to   { transform: scale(1.0)  translate(0,   0); }
  }
  @keyframes kb-pan-left {
    from { transform: scale(1.08) translate(2%,  0); }
    to   { transform: scale(1.08) translate(-2%, 0); }
  }
  @keyframes kb-pan-right {
    from { transform: scale(1.08) translate(-2%, 0); }
    to   { transform: scale(1.08) translate(2%,  0); }
  }

  .hero-slide-img.kb-active {
    animation-duration: 8000ms;
    animation-timing-function: linear;
    animation-fill-mode: both;
  }
  .hero-slide-img.kb-zoom-in    { animation-name: kb-zoom-in;    }
  .hero-slide-img.kb-zoom-out   { animation-name: kb-zoom-out;   }
  .hero-slide-img.kb-pan-left   { animation-name: kb-pan-left;   }
  .hero-slide-img.kb-pan-right  { animation-name: kb-pan-right;  }

  .hero-slide {
    transition: opacity 1200ms ease-in-out;
  }

  .hero-dot.active {
    width: 20px !important;
    background: rgba(118,175,194,1) !important;
  }
</style>

<script is:inline>
(function () {

  const tl = { run(d, fn) { setTimeout(fn, d); return tl; } };

  tl.run(100, () => {
    const flash = document.getElementById('hero-flash');
    if (flash) {
      flash.style.transition = 'transform 0.9s cubic-bezier(0.4,0,0.2,1), opacity 0.9s ease';
      flash.style.transform  = 'translateX(200%)';
      flash.style.opacity    = '0';
    }
  });

  tl.run(450, () => {
    const l1 = document.getElementById('hero-line1');
    if (l1) {
      l1.style.transition = 'opacity 0.6s ease, transform 0.6s cubic-bezier(0.16,1,0.3,1)';
      l1.style.opacity    = '1';
      l1.style.transform  = 'translateY(0)';
    }
  });

  tl.run(620, () => {
    const l2 = document.getElementById('hero-line2');
    if (l2) {
      l2.style.transition = 'opacity 0.6s ease, transform 0.6s cubic-bezier(0.16,1,0.3,1)';
      l2.style.opacity    = '1';
      l2.style.transform  = 'translateY(0)';
    }
  });

  tl.run(900, () => {
    const sub = document.getElementById('hero-sub');
    if (sub) {
      sub.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
      sub.style.opacity    = '1';
      sub.style.transform  = 'translateY(0)';
    }
  });

  tl.run(1000, () => {
    document.querySelectorAll('.stat-number').forEach(el => {
      const target   = parseInt(el.dataset.target);
      const prefix   = el.dataset.prefix || '';
      const suffix   = el.dataset.suffix || '';
      const duration = 1400;
      const t0       = performance.now();
      const ease     = t => t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      const tick = now => {
        const p = Math.min((now - t0) / duration, 1);
        el.textContent = prefix + Math.round(ease(p) * target) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  });

  tl.run(1400, () => {
    const sc = document.getElementById('hero-scroll');
    if (sc) { sc.style.transition = 'opacity 1s ease'; sc.style.opacity = '1'; }
  });

  /* Parallax */
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const hero = document.getElementById('hero');
        const activeSlide = document.querySelector('.hero-slide[style*="z-index: 2"], .hero-slide.on-top');
        if (activeSlide && hero) {
          const img = activeSlide.querySelector('.hero-slide-img');
          if (img && window.scrollY < hero.offsetHeight) {
            img.style.transform = `translateY(${window.scrollY * 0.12}px)`;
          }
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  /* Ken Burns + Carrusel */
  const slides = Array.from(document.querySelectorAll('.hero-slide'));
  const dots   = Array.from(document.querySelectorAll('.hero-dot'));

  if (slides.length === 0) return;

  function startKB(slide) {
    const img = slide.querySelector('.hero-slide-img');
    const ken = slide.dataset.ken || 'zoom-in';
    img.classList.remove('kb-zoom-in','kb-zoom-out','kb-pan-left','kb-pan-right','kb-active');
    void img.offsetWidth;
    img.classList.add('kb-active', `kb-${ken}`);
  }

  function goTo(next) {
    const current = slides.findIndex(s => parseFloat(s.style.opacity) === 1);
    if (next === current) return;

    slides[next].style.zIndex  = '3';
    slides[next].style.opacity = '1';
    startKB(slides[next]);

    if (current >= 0) {
      slides[current].style.opacity = '0';
      setTimeout(() => { slides[current].style.zIndex = '1'; }, 1200);
    }

    dots.forEach((d, i) => {
      d.classList.toggle('active', i === next);
      d.style.width      = i === next ? '20px' : '6px';
      d.style.background = i === next
        ? 'rgba(118,175,194,1)'
        : 'rgba(118,175,194,0.35)';
    });
  }

  startKB(slides[0]);

  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      current = (current + 1) % slides.length;
      goTo(current);
    }, 6000);

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
  }

})();
</script>