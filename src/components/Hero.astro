---
const title = "Blau i negre,";
const titleAccent = "orgull de Martorell";
const subtitle = "Cantera, competició i compromís al Baix Llobregat";
const heroImage = "/images/club/presentacion.jpg";
const logo = "/android-chrome-512x512.png";
---

<section class="relative h-screen max-h-[700px] min-h-[520px] flex items-end overflow-hidden">

  <!-- Imatge de fons -->
  <img
    src={heroImage}
    alt="Equip CV Martorell"
    class="absolute inset-0 w-full h-full object-cover object-top"
  />

  <!-- Gradient overlay: transparent a dalt, fosc a baix -->
  <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/60 to-transparent"></div>

  <!-- Contingut: escudo + text en fila, ancrat a baix -->
  <div class="relative z-10 w-full container mx-auto px-6 pb-16 pt-8">
    <div class="flex flex-col sm:flex-row items-center sm:items-end gap-6 sm:gap-8">

      <!-- Escudo -->
      <img
        src={logo}
        alt="Escudo CV Martorell"
        class="w-24 h-24 md:w-32 md:h-32 flex-shrink-0 drop-shadow-2xl"
      />

      <!-- Text -->
      <div class="text-center sm:text-left">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight tracking-tight drop-shadow-md">
          {title}<br/>
          <span class="text-brand-light">{titleAccent}</span>
        </h1>
        <p class="mt-3 text-white/70 text-base md:text-lg max-w-lg">
          {subtitle}
        </p>
      </div>

    </div>
  </div>

</section>