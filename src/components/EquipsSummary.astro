---
// EquipsSection.astro
import { equips } from "../data/equips";
---

<section class="section-light relative overflow-hidden pt-12 pb-24"
         aria-labelledby="equips-title">
		 
  <div class="relative max-w-6xl mx-auto px-6">

    <!-- Capçalera -->
    <div class="flex items-end justify-between mb-8 equips-reveal">
      <div>
        <p class="text-brand-light text-xs font-bold uppercase tracking-[0.3em] mb-1">
          Temporada 2025–26
        </p>
        <h2 id="equips-title" class="text-2xl md:text-3xl font-extrabold text-black tracking-tight">
          Els nostres equips
        </h2>
        <p class="text-black/70 text-sm mt-1">Més de 10 equips competint cada setmana</p>
      </div>
      <a href="/equips"
         class="hidden md:inline-flex items-center gap-2 text-brand-light text-sm font-bold
                hover:text-white transition-colors group">
        Veure tots
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- Sitting Volei -->
    <div class="equips-reveal mb-6">
      <a href="/equips#sitting"
         class="sitting-card group relative flex items-center gap-5 rounded-2xl overflow-hidden
                border border-catalan-yellow/30 px-6 py-5
                hover:border-catalan-yellow/60 transition-all duration-300">

        <div class="absolute inset-0">
          <img src="/images/equips/terra.jpg" alt="Vòlei Terra – Sitting Volei"
               class="w-full h-full object-cover object-center opacity-15" />
        </div>
        <div class="absolute inset-0 bg-brand-dark/60"></div>

        <!-- accent lateral -->
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-catalan-yellow/80 rounded-l-2xl"></div>

        <div class="relative flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center
                    text-2xl bg-catalan-yellow/10 border border-catalan-yellow/20">
          ♿
        </div>

        <div class="relative flex-grow min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <p class="text-white font-extrabold text-base leading-tight">Vòlei Terra</p>
            <span class="badge-yellow">Únics a Catalunya</span>
          </div>
          <p class="text-white/40 text-xs mt-1">Sitting Volei · Mixt · Absolut</p>
        </div>

        <div class="relative flex-shrink-0 text-catalan-yellow/50 group-hover:text-catalan-yellow
                    group-hover:translate-x-1 transition-all duration-200 text-lg">→</div>

        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
             style="background: radial-gradient(ellipse 60% 80% at 20% 50%, rgba(242,203,64,0.06) 0%, transparent 70%);"></div>
      </a>
    </div>

    <!-- Scroll horitzontal de pills -->
    <div class="equips-reveal">
      <div class="equips-track flex gap-3 overflow-x-auto pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:flex-wrap">
        {equips.map((e) => {
          const pill = (
            <div class={`equip-pill relative rounded-xl overflow-hidden w-36 md:w-40
                         ${e.foto ? '' : `bg-gradient-to-br ${e.color}`}
                         border border-white/[0.08] ${e.slug ? 'hover:border-white/20' : ''}`}
                 style={`--accent: ${e.accent};`}>

              {e.foto && (
                <div class="absolute inset-0">
                  <img src={e.foto} alt={`${e.categoria} ${e.equip ?? ''}`}
                       class="w-full h-full object-cover object-top" loading="lazy" />
                  <div class="absolute inset-0 pill-photo-overlay"></div>
                </div>
              )}

              <div class="absolute top-0 left-0 right-0 h-[2px]"
                   style={`background: linear-gradient(90deg, transparent, ${e.accent}, transparent);`}></div>

              <div class="relative p-4">
                <p class="text-white font-extrabold text-sm leading-tight">
                  {e.categoria}
                  {e.equip && <span class="font-normal text-white/70"> {e.equip}</span>}
                </p>
                <p class="text-xs mt-0.5 font-medium" style={`color: ${e.accent};`}>{e.genere}</p>
                {e.divisio  && <p class="text-white/60 text-xs mt-1 leading-tight">{e.divisio}</p>}
                <p class="text-white/70 text-xs mt-2 uppercase tracking-wide">{e.edats}</p>
                {e.entrenador && <p class="text-white/80 text-xs mt-1 italic">{e.entrenador}</p>}
                {e.slug && (
                  <p class="text-xs mt-2 font-semibold" style={`color: ${e.accent};`}>
                    Veure stats →
                  </p>
                )}
              </div>
            </div>
          );

          return e.slug ? (
            <a href={`/equips/${e.slug}`} class="flex-shrink-0 block">{pill}</a>
          ) : (
            <div class="flex-shrink-0">{pill}</div>
          );
        })}
      </div>
    </div>

    <div class="mt-6 text-center md:hidden equips-reveal">
      <a href="/equips"
         class="inline-flex items-center gap-2 text-brand-light text-sm font-bold hover:text-white transition-colors">
        Veure tots els equips →
      </a>
    </div>

  </div>
</section>

<style>
  .hero-ambient {
    opacity: 0.05;
    background-image: radial-gradient(ellipse 70% 80% at 50% 50%, var(--brand-light) 0%, transparent 70%);
  }

  .sitting-card {
    background: linear-gradient(to right, rgba(66, 32, 6, 0.6), var(--brand-dark));
  }

  .badge-yellow {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-yellow);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: rgba(242, 203, 64, 0.15);
    border: 1px solid rgba(242, 203, 64, 0.3);
  }

  .pill-photo-overlay {
    background: linear-gradient(
      to top,
      var(--brand-dark) 0%,
      rgba(13, 28, 35, 0.85) 50%,
      rgba(13, 28, 35, 0.55) 100%
    );
  }

  .equips-track      { scrollbar-width: none; -ms-overflow-style: none; }
  .equips-track::-webkit-scrollbar { display: none; }

  .equips-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .equips-reveal.visible { opacity: 1; transform: translateY(0); }

  .equip-pill { transition: transform 0.2s ease, border-color 0.2s ease; }
  .equip-pill:hover { transform: translateY(-3px); }
</style>

<script is:inline>
{
  const reveals  = document.querySelectorAll('.equips-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 100);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  reveals.forEach(el => observer.observe(el));
}
</script>