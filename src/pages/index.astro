---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClubActivity from "../components/ClubActivity.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import Hero from "../components/Hero.astro";

const page = {
  title: "El voleibol viu a Martorell – CV Martorell",
  description: "Entrenaments, partits i moments del CV Martorell. Descobreix el nostre dia a dia i segueix-nos a Instagram.",
};
---

<BaseLayout title={page.title} description={page.description}>
  <main id="contenido" class="flex-grow">

    <!-- Hero destacat amb text centrat i tipografia més marcada -->
    <Hero class="text-center font-extrabold" />

    <!-- Club Activity -->
    <ClubActivity />

    <!-- Patrocinadors -->
    <SponsorGrid />

    </main>
</BaseLayout>