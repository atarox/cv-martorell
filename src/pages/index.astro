---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import EquipsSummary from "../components/EquipsSummary.astro";
import ClubActivity from "../components/ClubActivity.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import PropersPartits from "../components/PropersPartits.astro";

const page = {
  title: "El voleibol viu a Martorell – CV Martorell",
  description:
    "Entrenaments, partits i moments del CV Martorell. Descobreix el nostre dia a dia i segueix-nos a Instagram.",
};
---

<BaseLayout title={page.title} description={page.description}>

  <!-- HERO (oscuro controlado por componente) -->
  <Hero />

  <!-- BLOQUE PRINCIPAL (YA CLARO POR SISTEMA) -->
  <section class="bg-ui-page">
    <div class="space-y-12 py-12">

      <PropersPartits />

      <SponsorGrid />

      <EquipsSummary />

      <ClubActivity />

    </div>
  </section>

</BaseLayout>