---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClubActivity from "../components/ClubActivity.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import Hero from "../components/Hero.astro";

const page = {
  title: "Club Voleibol Martorell – Formant jugadors i creant equip",
  description: "Entrenaments, partits i moments del CV Martorell. Descobreix el nostre dia a dia i segueix-nos a Instagram.",
};
---

<BaseLayout title={page.title} description={page.description}>
  <main id="contenido" class="flex-grow">

    <!-- Hero destacat amb text centrat i tipografia més marcada -->
    <Hero class="text-center font-extrabold" />

    <!-- Club Activity -->
    <section class="container mx-auto px-4 md:px-6 py-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-dark tracking-tight mb-6 text-center">
        El club està viu
      </h2>
      <p class="text-ui-text text-center mb-12 text-lg md:text-xl">
        Entrenaments, partits i moments que ens defineixen
      </p>
      <ClubActivity />
    </section>

    <!-- Patrocinadors amb efectes moderns -->
    <section aria-labelledby="patrocinadors" class="container mx-auto px-4 md:px-6 py-16">
      <h2 id="patrocinadors" class="text-2xl md:text-3xl font-extrabold tracking-tight text-brand-dark mb-8 text-center">
        Els nostres patrocinadors
      </h2>
      <SponsorGrid class="grid gap-6" />
    </section>

    </main>
</BaseLayout>