---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import ClubActivity from "../components/ClubActivity.astro";

const page = {
  title: "Club Voleibol Martorell – Formando jugadores y creando equipo",
  description: "Entrenos, partidos y momentos del CV Martorell. Descubre nuestro día a día y síguenos en Instagram.",
};
---

<BaseLayout title={page.title} description={page.description}>
  <Fragment slot="head">
    <link rel="canonical" href="https://cv-martorell.cat/"
  <main id="contenido" class="flex-grow">
    <!-- Hero compacto -->
    <section class="container mx-auto px-4 pt-10">
      <h1 class="sr-only">Club Voleibol Martorell</h1>
      <div class="rounded-xl bg-white/60 backdrop-blur p-6 shadow-soft">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-brand-dark">
          El club está vivo
        </h2>
        <p class="mt-2 text-muted">
          Entrenos, partidos y momentos que nos definen.
        </p>
      </div>
    </section>

    <!-- Actividad del club (galería/cards) -->
    <section class="container mx-auto px-4 py-8">
      <ClubActivity />
    </section>

    <!-- Sponsors -->
    <section aria-labelledby="nuestros-sponsors" class="container mx-auto px-4 pb-16">
      <h2 id="nuestros-sponsors" class="text-2xl md:text-3xl font-semibold tracking-tight text-brand-dark mb-6">
        Nuestros Sponsors
      </h2>
      <SponsorGrid />
    </section>
  </main>

  <Footer />
</BaseLayout>