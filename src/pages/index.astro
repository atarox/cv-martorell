---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Separador from "../components/Separador.astro";
import EquipsSummary from "../components/EquipsSummary.astro";
import ClubActivity from "../components/ClubActivity.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
const page = {
  title: "El voleibol viu a Martorell – CV Martorell",
  description: "Entrenaments, partits i moments del CV Martorell. Descobreix el nostre dia a dia i segueix-nos a Instagram.",
};
---
<BaseLayout title={page.title} description={page.description}>
  <main id="contenido" class="flex-grow">
    <Hero />
    <!-- Hero (#0D1C23) → SponsorGrid (#0D1C23): mateix color, separador daurat per anticipar secció premium -->
    <Separador fromColor="#0D1C23" toColor="#0D1C23" accent="#F2CB40" />
    <SponsorGrid />
    <!-- SponsorGrid (#0D1C23) → EquipsSummary (#0D1C23): mateix color, separador decoratiu -->
    <Separador fromColor="#0D1C23" toColor="#0D1C23" accent="#76AFC2" />
    <EquipsSummary />
    <!-- EquipsSummary (#0D1C23) → ClubActivity (#E2F4FB) -->
    <Separador fromColor="#0D1C23" toColor="#E2F4FB" accent="#76AFC2" flip={true} />
    <ClubActivity />
  </main>
</BaseLayout>
 