---
import BaseLayout from "../layouts/BaseLayout.astro";
import { equips } from "../data/equips";

const page = {
  title: "Equips – CV Martorell",
  description:
    "Tots els equips del Club Voleibol Martorell: aleví, infantil, cadet, juvenil, júnior i sènior, masculí i femení.",
};

const categories = [...new Set(equips.map((e) => e.categoria))];
---

<BaseLayout title={page.title} description={page.description}>

  <!-- HERO -->
  <div class="relative bg-brand-dark text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none"
      style="background: radial-gradient(circle at 30% 40%, #76AFC2 0%, transparent 60%)"></div>

    <div class="container mx-auto px-6 pt-32 pb-16 text-center relative">
      <p class="text-brand-light text-sm font-semibold uppercase tracking-widest mb-3">
        Club Voleibol Martorell
      </p>

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">
        Els nostres equips
      </h1>

      <p class="mt-4 text-white/60 text-lg max-w-xl mx-auto">
        Sis categories, dos gèneres, un sol club.
      </p>
    </div>
  </div>

  <!-- FILTROS -->
  <div class="sticky top-0 z-10 bg-ui-bg/90 backdrop-blur border-b border-brand-light/20">
    <div class="container mx-auto px-6 py-3 flex gap-2 overflow-x-auto">

      <button
        data-filter="tots"
        class="filter-btn active flex-shrink-0 rounded-full px-4 py-1.5 text-sm font-semibold
               bg-brand-dark text-white"
      >
        Tots
      </button>

      {categories.map((cat) => (
        <button
          data-filter={cat.toLowerCase()}
          class="filter-btn flex-shrink-0 rounded-full px-4 py-1.5 text-sm font-semibold
                 bg-white text-ui-text border border-brand-light/30
                 hover:bg-brand-light hover:text-white transition"
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- GRID -->
  <section class="bg-ui-bg">
    <div class="container mx-auto px-6 py-16">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="equips-grid">

     <article
  id="sitting"
  class="group w-full rounded-2xl overflow-hidden
         bg-brand-dark text-white shadow-card
         hover:shadow-hover transition"
>

<!-- IMAGE (ARRIBA) -->
<div class="relative h-48 md:h-56 overflow-hidden">

  <!-- Imagen -->
  <img
    src="/images/equips/terra.jpg"
    alt="Vòlei Terra – Sitting Volei"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>

  <!-- Badge -->
  <span
    class="absolute top-4 left-4 z-10 text-xs font-bold uppercase px-2 py-1 rounded-full
           bg-catalan-yellow/20 text-catalan-yellow border border-catalan-yellow/30"
  >
    Únic a Catalunya
  </span>

  <!-- Icon -->
  <div
    class="absolute bottom-4 right-4 z-10
           w-14 h-14 rounded-xl flex items-center justify-center
           bg-catalan-yellow/10 border border-catalan-yellow/30 text-2xl"
  >
    ♿
  </div>

</div>

  <!-- CONTENT (ABAJO) -->
  <div class="p-6 md:p-8">

    <h2 class="text-2xl font-extrabold">
      Vòlei Terra
    </h2>

    <p class="mt-2 text-sm text-white/70 max-w-3xl">
      Sitting vòlei mixt amb projecció competitiva.
      Projecte inclusiu i únic dins del voleibol català.
    </p>

    <a
      href="/contacte"
      class="inline-flex mt-4 text-sm font-semibold text-catalan-yellow
             hover:text-white transition"
    >
      Contacta →
    </a>

  </div>
</article>

        <!-- EQUIP CARDS -->
        {equips.map((equip) => (
          <article
            data-categoria={equip.categoria.toLowerCase()}
            class="group bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-hover transition"
          >

            <!-- IMAGE -->
            <div class="relative h-56 overflow-hidden">
              {equip.foto ? (
                <img
                  src={equip.foto}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
              ) : (
                <div class={`h-full bg-gradient-to-br ${equip.color}`}></div>
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>

              <div
                class="absolute top-3 left-3 text-xs font-bold px-2 py-1 rounded-full text-white"
                style={`background:${equip.accent}`}
              >
                {equip.edats}
              </div>
            </div>

            <!-- CONTENT -->
            <div class="p-5">

              <h2 class="text-lg font-extrabold text-ui-text">
                {equip.categoria}
                {equip.equip && (
                  <span class="ml-1 text-sm font-semibold text-ui-muted">
                    {equip.equip}
                  </span>
                )}
              </h2>

              <p class="text-sm text-ui-muted mt-1">
                {equip.genere} · {equip.divisio}
              </p>

              <p class="text-xs text-ui-muted mt-3">
                {equip.entrenador}
              </p>

              {equip.slug && (
                <a
                  href={`/equips/${equip.slug}`}
                  class="inline-flex mt-4 text-sm font-semibold text-brand-light hover:text-brand-dark transition"
                >
                  Veure stats →
                </a>
              )}

				{equip.patrocinador?.logo && (
				  <div class="mt-4 flex items-center gap-2">
					<a
					  href={equip.patrocinador.url}
					  target="_blank"
					  rel="noopener noreferrer"
					  class="inline-flex items-center"
					  title={equip.patrocinador.nom}
					>
					  <img
						src={equip.patrocinador.logo}
						alt={equip.patrocinador.nom}
						class="h-6 object-contain opacity-80 hover:opacity-100 transition"
						loading="lazy"
					  />
					</a>
				  </div>
				)}

            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-brand-dark text-white py-16 text-center">
    <h2 class="text-2xl font-extrabold">Vols unir-te al club?</h2>
    <p class="text-white/60 mt-2 mb-6">
      Escriu-nos i t’informem de les proves.
    </p>

    <a href="/contacte"
       class="inline-flex items-center px-6 py-3 rounded-full bg-brand-light text-brand-dark font-bold">
      Contactar
    </a>
  </section>

</BaseLayout>

<script is:inline>
{
  const btns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll("[data-categoria]");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter;

      cards.forEach((card) => {
        const match =
          filter === "tots" || card.dataset.categoria === filter;

        card.classList.toggle("hidden", !match);
      });
    });
  });
}
</script>