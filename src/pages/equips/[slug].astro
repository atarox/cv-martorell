---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { equips } from "../../data/equips";

export async function getStaticPaths() {
  return equips
    .filter(e => e.slug)
    .map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const equip = equips.find(e => e.slug === slug);

if (!equip) return Astro.redirect("/equips");

const foto = equip.foto;
const patro = equip.patrocinador ?? null;
const WORKER_URL = "https://cv-martorell-worker.informatica-179.workers.dev";

let dades: any = null;
let error: string | null = null;

try {
  const res = await fetch(`${WORKER_URL}/equip/${slug}`);
  if (res.ok) dades = await res.json();
  else error = "No s'han pogut carregar les dades.";
} catch {
  error = `Error de connexió`;
}

const accentLight = equip.accent ?? "var(--brand-light)";

function esMartorell(nom: string): boolean {
  return nom?.toUpperCase().includes("MARTORELL");
}

function formatData(data: string | null): string {
  return data ? data.trim() : "—";
}
---

<BaseLayout
  title={dades ? `${dades.nom} – CV Martorell` : `${equip.nom} – CV Martorell`}
  description={dades ? `Resultats i classificació de ${dades.nom}` : equip.nom}
>

  <!-- ── HERO ── -->
  <div class="section-hero relative overflow-hidden" style="min-height: min(100svh, 900px);">

    {foto ? (
      <div class="absolute inset-0">
        <img src={foto} alt={equip.nom} class="w-full h-full object-cover object-center" />
        <div class="absolute inset-0 hero-gradient"></div>
      </div>
    ) : (
      <div class="absolute inset-0">
        <div class="absolute inset-0 hero-ambient"></div>
      </div>
    )}

    <div class="relative container mx-auto px-6 pt-32 pb-16 flex flex-col justify-end h-full"
         style="min-height: inherit;">

      <a href="/equips"
         class="inline-flex items-center gap-2 text-white/50 hover:text-white/90 text-sm mb-6 w-fit transition-colors">
        ← Tots els equips
      </a>

      <p class="text-sm font-semibold uppercase tracking-widest mb-2"
         style={`color: ${accentLight};`}>
        Temporada 2025–26
      </p>

      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight">
        {dades?.nom ?? equip.nom}
      </h1>

      {patro && (
        <a href={patro.url} target="_blank" rel="noopener noreferrer"
           class="sponsor-badge mt-5 inline-flex items-center gap-4 rounded-2xl px-5 py-3 w-fit
                  hover:bg-black/40 transition-all">
          <img src={patro.logo} alt={patro.nom} class="h-10 max-w-[140px] object-contain" />
          <div>
            <p class="text-white/40 text-xs uppercase tracking-widest">Patrocinador oficial</p>
            <p class="text-white font-semibold text-sm">{patro.nom}</p>
          </div>
        </a>
      )}

      {dades?.posicio && (
        <div class="stat-badge mt-6 inline-flex items-center gap-3 rounded-2xl px-5 py-3 w-fit">
          <span class="text-3xl font-extrabold" style={`color: ${accentLight};`}>
            #{dades.posicio.pos}
          </span>
          <div>
            <p class="text-white/40 text-xs uppercase">Posició</p>
            <p class="text-white text-sm font-semibold">
              {dades.posicio.gan}V · {dades.posicio.per}D · {dades.posicio.punts} pts
            </p>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- ── ERROR ── -->
  {error && (
    <div class="section-light">
      <div class="container mx-auto px-6 py-16 text-center text-ui-textMuted">{error}</div>
    </div>
  )}

  <!-- ── CONTINGUT ── -->
  {dades && (
    <section class="section-light">
      <div class="container mx-auto px-4 md:px-6 py-16 space-y-6">

        <!-- Últim resultat + proper partit -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="data-card">
            <p class="card-label" style={`color: ${accentLight};`}>Últim resultat</p>
            {dades.ultimResultat ? (
              <div class="flex justify-between items-center mt-4">
                <span class={esMartorell(dades.ultimResultat.local) ? "team-name--us" : "team-name--them"}>
                  {dades.ultimResultat.local}
                </span>
                <span class="score">{dades.ultimResultat.marcador}</span>
                <span class={esMartorell(dades.ultimResultat.visitant) ? "team-name--us" : "team-name--them"}>
                  {dades.ultimResultat.visitant}
                </span>
              </div>
            ) : (
              <p class="text-white/30 mt-4">Sense dades</p>
            )}
          </div>

          <div class="data-card">
            <p class="card-label" style={`color: ${accentLight};`}>Proper partit</p>
            {dades.propersPartits?.[0] ? (
              <div class="flex justify-between items-center mt-4">
                <span class="team-name--us">{dades.propersPartits[0].local}</span>
                <span class="text-white/30 text-sm font-bold">VS</span>
                <span class="team-name--us">{dades.propersPartits[0].visitant}</span>
              </div>
            ) : (
              <p class="text-white/30 mt-4">Sense partits</p>
            )}
          </div>
        </div>

        <!-- Classificació -->
        {dades.clasificacion?.length > 0 && (
          <div class="data-card !p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-white/10">
              <p class="card-label" style={`color: ${accentLight};`}>Classificació</p>
            </div>
            <div class="divide-y divide-white/5">
              {dades.clasificacion.map((fila: any) => (
                <div class="flex justify-between px-6 py-3 text-sm text-white/80">
                  <span class="w-8 text-white/40">{fila.pos}</span>
                  <span class="flex-1">{fila.equip}</span>
                  <span class="font-bold text-white">{fila.punts}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Partits jugats -->
        {dades.jugats.length > 0 && (
          <div class="data-card !p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-white/10">
              <p class="card-label" style={`color: ${accentLight};`}>Partits jugats</p>
            </div>
            <div class="divide-y divide-white/5">
              {dades.jugats.map((p: any) => (
                <div class="px-6 py-4 flex items-center gap-4">
                  <div class="flex-1 text-right">
                    <p class={`text-sm font-semibold leading-tight ${esMartorell(p.local) ? "team-name--us" : "team-name--them"}`}>
                      {p.local}
                    </p>
                  </div>
                  <div class="flex-shrink-0 text-center min-w-[80px]">
                    <span class="score">{p.marcador ?? "—"}</span>
                    <p class="text-white/20 text-xs mt-0.5">{formatData(p.data)}</p>
                  </div>
                  <div class="flex-1 text-left">
                    <p class={`text-sm font-semibold leading-tight ${esMartorell(p.visitant) ? "team-name--us" : "team-name--them"}`}>
                      {p.visitant}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Propers partits -->
        {dades.propersPartits.length > 0 && (
          <div class="data-card !p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-white/10">
              <p class="card-label" style={`color: ${accentLight};`}>Propers partits</p>
            </div>
            <div class="divide-y divide-white/5">
              {dades.propersPartits.map((p: any) => (
                <div class="px-6 py-4 flex items-center gap-4">
                  <div class="flex-1 text-right">
                    <p class={`text-sm font-semibold leading-tight ${esMartorell(p.local) ? "team-name--us" : "team-name--them"}`}>
                      {p.local}
                    </p>
                  </div>
                  <div class="flex-shrink-0 text-center min-w-[80px]">
                    <span class="text-sm font-bold text-white/30">VS</span>
                    <p class="text-white/20 text-xs mt-0.5">{formatData(p.data)}</p>
                  </div>
                  <div class="flex-1 text-left">
                    <p class={`text-sm font-semibold leading-tight ${esMartorell(p.visitant) ? "team-name--us" : "team-name--them"}`}>
                      {p.visitant}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <p class="text-center text-ui-textMuted text-xs pt-4">
          Actualitzat: {dades?.actualitzat
            ? new Date(dades.actualitzat).toLocaleString("ca-ES")
            : "—"}
        </p>

      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Hero overlays ── */
  .hero-gradient {
    background: linear-gradient(
      to top,
      var(--brand-dark) 0%,
      rgba(13, 28, 35, 0.85) 40%,
      rgba(13, 28, 35, 0.2) 100%
    );
  }
  .hero-ambient {
    opacity: 0.1;
    background-image:
      radial-gradient(circle at 20% 50%, var(--brand-light) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, var(--brand-mid) 0%, transparent 50%);
  }

  /* ── Badges sobre el hero ── */
  .sponsor-badge,
  .stat-badge {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* ── Data cards (sobre fons clar) ── */
  .data-card {
    background: var(--brand-dark);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .card-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .score {
    font-size: 1.125rem;
    font-weight: 800;
    color: white;
    font-variant-numeric: tabular-nums;
  }

  .team-name--us   { font-size: 0.875rem; font-weight: 600; color: white; }
  .team-name--them { font-size: 0.875rem; font-weight: 600; color: rgba(255,255,255,0.35); }
</style>