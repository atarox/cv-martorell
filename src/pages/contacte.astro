---
import BaseLayout from "../layouts/BaseLayout.astro";

const page = {
  title: "Contacte – CV Martorell",
  description: "Posa't en contacte amb el Club Voleibol Martorell. Estem aquí per a qualsevol consulta sobre equips, inscripcions o patrocinis.",
};

const motius = [
  "Inscripció a un equip",
  "Informació sobre equips",
  "Patrocinis i col·laboracions",
  "Instal·lacions i reserves",
  "Altres consultes",
];
---

<BaseLayout title={page.title} description={page.description}>

  <!-- Hero -->
  <div class="relative bg-brand-dark overflow-hidden">
    <div class="absolute inset-0 opacity-10"
         style="background-image: radial-gradient(circle at 70% 30%, #76AFC2 0%, transparent 55%), radial-gradient(circle at 20% 80%, #2B6E7F 0%, transparent 50%);"></div>
    <div class="relative container mx-auto px-6 pt-32 pb-16 text-center">
      <p class="text-brand-light text-sm font-semibold uppercase tracking-widest mb-3">Estem aquí per ajudar-te</p>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight">Contacte</h1>
      <p class="mt-4 text-white/60 text-lg max-w-xl mx-auto">
        Qualsevol dubte sobre equips, inscripcions o patrocinis, escriu-nos i et responem aviat.
      </p>
    </div>
  </div>

  <!-- Contingut principal -->
  <section class="container mx-auto px-4 md:px-6 py-16">
    <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-12">

      <!-- Informació de contacte (esquerra) -->
      <aside class="md:col-span-2 space-y-8">

        <div>
          <h2 class="text-xl font-extrabold text-brand-dark mb-5">On trobar-nos</h2>
          <ul class="space-y-5">

            <li class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-dark flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-brand-dark text-sm">Adreça</p>
                <p class="text-ui-text text-sm mt-0.5">
                  Pavelló Municipal Can Cases<br/>
                  Carrer Josep Vilar s/n<br/>
                  08635 Martorell, Barcelona
                </p>
              </div>
            </li>

            <li class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-dark flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-brand-dark text-sm">Correu electrònic</p>
                <a href="mailto:administracio@clubvoleimartorell.com"
                   class="text-secondary-blue text-sm hover:text-brand-dark transition-colors mt-0.5 block break-all">
                  administracio@clubvoleimartorell.com
                </a>
              </div>
            </li>

            <li class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-dark flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-brand-dark text-sm">Telèfon</p>
                <a href="tel:+34937750050"
                   class="text-secondary-blue text-sm hover:text-brand-dark transition-colors mt-0.5 block">
                  +34 937 75 00 50
                </a>
              </div>
            </li>

          </ul>
        </div>

		<!-- Horari d'atenció -->
		<div class="rounded-2xl bg-brand-dark p-6 text-white">
		  <h3 class="font-extrabold text-base mb-4 text-brand-light">
			Horari d'atenció
		  </h3>

		  <ul class="space-y-3 text-sm">
			<li class="flex justify-between items-center">
			  <span class="text-white/70">Dilluns</span>
			  <span class="text-white font-medium">19:00 – 20:30</span>
			</li>

			<li class="flex justify-between items-center">
			  <span class="text-white/70">Divendres</span>
			  <span class="text-white font-medium">19:00 – 21:00</span>
			</li>
		  </ul>
		</div>

        <!-- Xarxes -->
        <div>
          <h3 class="font-extrabold text-brand-dark text-sm mb-3">Segueix-nos</h3>
          <a
            href="https://instagram.com/clubvoleimartorell"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-ui-text hover:text-brand-dark transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M7.75 2h8.5C19.55 2 22 4.45 22 7.75v8.5C22 19.55 19.55 22 16.25 22h-8.5C4.45 22 2 19.55 2 16.25v-8.5C2 4.45 4.45 2 7.75 2zm0 1.5C5.68 3.5 4 5.18 4 7.25v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 3.5 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm4.75-.88a1.12 1.12 0 1 1 0 2.25 1.12 1.12 0 0 1 0-2.25z"/>
            </svg>
            @clubvoleimartorell
          </a>
        </div>

      </aside>

      <!-- Formulari (dreta) -->
      <div class="md:col-span-3">
        <div class="rounded-2xl bg-white shadow-soft border border-brand-light/20 p-8">
          <h2 class="text-xl font-extrabold text-brand-dark mb-6">Envia'ns un missatge</h2>

          <!-- Missatge d'èxit (ocult per defecte) -->
          <div id="form-success"
               class="hidden mb-6 rounded-xl bg-teal-50 border border-teal-200 p-4 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <div>
              <p class="font-semibold text-teal-800 text-sm">Missatge enviat correctament!</p>
              <p class="text-teal-700 text-sm mt-0.5">Ens posarem en contacte amb tu el més aviat possible.</p>
            </div>
          </div>

          <!-- Missatge d'error (ocult per defecte) -->
          <div id="form-error"
               class="hidden mb-6 rounded-xl bg-red-50 border border-red-200 p-4 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <div>
              <p class="font-semibold text-red-800 text-sm">Hi ha hagut un error en enviar el missatge.</p>
              <p class="text-red-700 text-sm mt-0.5">Si us plau, prova-ho de nou o escriu-nos directament per correu.</p>
            </div>
          </div>

          <form id="contact-form" novalidate class="space-y-5">

            <!-- Nom i cognom -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nom" class="block text-sm font-semibold text-brand-dark mb-1.5">Nom <span class="text-red-500">*</span></label>
                <input
                  type="text" id="nom" name="nom" required
                  placeholder="El teu nom"
                  class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                         text-brand-dark placeholder-ui-text
                         focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                         transition-colors"
                />
              </div>
              <div>
                <label for="cognom" class="block text-sm font-semibold text-brand-dark mb-1.5">Cognoms</label>
                <input
                  type="text" id="cognom" name="cognom"
                  placeholder="Els teus cognoms"
                  class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                         text-brand-dark placeholder-ui-text
                         focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                         transition-colors"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Correu electrònic <span class="text-red-500">*</span></label>
              <input
                type="email" id="email" name="email" required
                placeholder="tu@email.com"
                class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                       text-brand-dark placeholder-ui-text
                       focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                       transition-colors"
              />
            </div>

            <!-- Telèfon (opcional) -->
            <div>
              <label for="telefon" class="block text-sm font-semibold text-brand-dark mb-1.5">
                Telèfon <span class="text-ui-text font-normal">(opcional)</span>
              </label>
              <input
                type="tel" id="telefon" name="telefon"
                placeholder="+34 6XX XXX XXX"
                class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                       text-brand-dark placeholder-ui-text
                       focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                       transition-colors"
              />
            </div>

            <!-- Motiu -->
            <div>
              <label for="motiu" class="block text-sm font-semibold text-brand-dark mb-1.5">Motiu de la consulta <span class="text-red-500">*</span></label>
              <select
                id="motiu" name="motiu" required
                class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                       text-brand-dark
                       focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                       transition-colors appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Selecciona un motiu…</option>
                {motius.map(m => <option value={m}>{m}</option>)}
              </select>
            </div>

            <!-- Missatge -->
            <div>
              <label for="missatge" class="block text-sm font-semibold text-brand-dark mb-1.5">Missatge <span class="text-red-500">*</span></label>
              <textarea
                id="missatge" name="missatge" required rows="5"
                placeholder="Explica'ns en què et podem ajudar…"
                class="w-full rounded-xl border border-brand-light/40 bg-ui-bg/50 px-4 py-2.5 text-sm
                       text-brand-dark placeholder-ui-text resize-none
                       focus:outline-none focus:ring-2 focus:ring-brand-dark/30 focus:border-brand-dark
                       transition-colors"
              ></textarea>
            </div>

            <!-- Privacitat -->
            <div class="flex items-start gap-3">
              <input
                type="checkbox" id="privacitat" name="privacitat" required
                class="mt-0.5 h-4 w-4 rounded border-brand-light/40 text-brand-dark
                       focus:ring-brand-dark/30 cursor-pointer flex-shrink-0"
              />
              <label for="privacitat" class="text-xs text-ui-text cursor-pointer">
                He llegit i accepto la <a href="/legal" class="underline hover:text-brand-dark transition-colors">política de privacitat</a>. Les meves dades s'utilitzaran únicament per respondre la meva consulta a través de correu electrònic.

              </label>
            </div>

            <!-- Botó d'enviament -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full rounded-xl bg-brand-dark text-white px-6 py-3 font-bold text-sm
                     hover:bg-secondary-blue transition-colors shadow-soft
                     focus:outline-none focus:ring-2 focus:ring-brand-dark/40
                     disabled:opacity-50 disabled:cursor-not-allowed
                     flex items-center justify-center gap-2"
            >
              <span id="btn-text">Enviar missatge</span>
              <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 14.627 0 12 8h4a8 8 0 01-8 8V24C5.373 24 3 12 12z"></path>
              </svg>
            </button>

          </form>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validació bàsica
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Estat de càrrega
    submitBtn.disabled = true;
    btnText.textContent = 'Enviant…';
    btnSpinner.classList.remove('hidden');
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const data = new FormData(form);
    const nom = data.get('nom');
    const cognom = data.get('cognom') || '';
    const email = data.get('email');
    const telefon = data.get('telefon') || 'No indicat';
    const motiu = data.get('motiu');
    const missatge = data.get('missatge');

    // Enviament via mailto com a fallback (no cal backend)
    // En producció, substitueix per fetch a /api/contact o un servei com Formspree/Resend
    try {
      const subject = encodeURIComponent(`[CV Martorell] ${motiu} – ${nom} ${cognom}`);
      const body = encodeURIComponent(
        `Nom: ${nom} ${cognom}\nEmail: ${email}\nTelèfon: ${telefon}\nMotiu: ${motiu}\n\nMissatge:\n${missatge}`
      );
      window.location.href = `mailto:administracio@clubvoleimartorell.com?subject=${subject}&body=${body}`;

      // Mostra missatge d'èxit
      successMsg.classList.remove('hidden');
      form.reset();
    } catch {
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Enviar missatge';
      btnSpinner.classList.add('hidden');
    }
  });
</script>
