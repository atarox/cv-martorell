---
import BaseLayout from "../layouts/BaseLayout.astro";
 

const page = {
  title: "Informació al soci – CV Martorell",
  description: "Documentació, protocols i recursos per a socis i famílies del Club Voleibol Martorell.",
};

// Llegim els comunicats des dels fitxers Markdown
const arxius = await Astro.glob("../content/comunicats/*.md");
const comunicats = arxius
  .map((f) => f.frontmatter)
  .sort((a, b) => new Date(b.data).getTime() - new Date(a.data).getTime());
  
const documents = [
  {
    title: "Codi de conducta",
    description: "Normes de convivència i comportament que tots els jugadors, famílies i membres del club han signat i acceptat.",
    icon: "📋",
    file: "/docs/codi-de-conducta.pdf",
    badge: "PDF",
    color: "from-sky-900/80 to-brand-dark/90",
    accent: "#76AFC2",
  },
{
  title: "Quotes 2026–2027",
  description: "Import de les quotes per a la temporada 2026/2027.",
  icon: "💶",
  file: "/docs/quotes.pdf",
  badge: "PDF",
  color: "from-teal-900/80 via-cyan-800/70 to-brand-dark/90",
  accent: "#2B6E7F",
},
];

const faqs = [
  {
    q: "Quan es fan efectives les quotes?",
    a: "Les quotes es domicilien a principis de cada mes. Si tens algun problema amb el pagament, contacta'ns abans del dia 25.",
  },
  {
    q: "Qui cobreix la mútua en cas de lesió?",
    a: "La mútua cobreix totes les lesions produïdes durant activitats oficials del club (entrenaments i partits). Consulta el protocol per als passos a seguir.",
  },
  {
    q: "Com puc donar de baixa a un jugador?",
    a: "Envia un correu a administracio@clubvoleimartorell.com amb el nom del jugador i la categoria, amb un mínim de 15 dies d'antelació.",
  },
];

function formatData(iso: string) {
  return new Date(iso).toLocaleDateString("ca-ES", {
    day: "numeric", month: "long", year: "numeric"
  });
}
---

<BaseLayout title={page.title} description={page.description}>

  <!-- Hero -->
  <div class="relative bg-brand-dark overflow-hidden">
    <div class="absolute inset-0 opacity-10"
         style="background-image: radial-gradient(circle at 30% 60%, #76AFC2 0%, transparent 55%), radial-gradient(circle at 75% 20%, #2B6E7F 0%, transparent 50%);"></div>
    <div class="relative container mx-auto px-6 pt-32 pb-16 text-center">
      <p class="text-brand-light text-sm font-semibold uppercase tracking-widest mb-3">Club Voleibol Martorell</p>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight">Informació al soci</h1>
      <p class="mt-4 text-white/60 text-lg max-w-xl mx-auto">
        Tots els documents i protocols que necessites com a membre del club, en un sol lloc.
      </p>
    </div>
  </div>

<!-- Comunicats -->
<section class="container mx-auto px-4 md:px-6 py-16 max-w-2xl">
  <p class="text-brand-light text-sm font-semibold uppercase tracking-widest mb-2 text-center">
    Informació del club
  </p>

  <h2 class="text-2xl md:text-3xl font-extrabold text-brand-dark mb-10 text-center">
    Comunicats
  </h2>

  <div class="rounded-2xl p-4 md:p-6 space-y-4" style="background:#e5ddd5">
    {comunicats.slice(0, 3).map((c) => (
      <article class="flex flex-col max-w-[92%] ml-auto px-1">
        
        <div class="rounded-2xl rounded-tr-sm px-4 py-3 shadow-sm" style="background:#dcf8c6">

          <p class="text-xs font-extrabold mb-1" style="color:#075e54">
           ⚪ CV Martorell
          </p>

          <p class="font-bold text-sm mb-2" style="color:#111">
            {c.titol}
          </p>

          <p class="text-sm leading-relaxed whitespace-pre-line" style="color:#303030">
            {c.cos}
          </p>

          {c.formulari && (
            <a
              href={c.formulari}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold transition"
              style="background:#075e54;color:white"
            >
              📄 {c.formulariLabel ?? "Accedir al formulari"}
            </a>
          )}

          <p class="text-right text-xs mt-2" style="color:#8a8a8a">
            {formatData(c.data)} ✓✓
          </p>

        </div>
      </article>
    ))}
  </div>
</section>
  <!-- Documents -->
  <section class="container mx-auto px-4 md:px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-extrabold text-brand-dark mb-2 text-center">Documents</h2>
    <p class="text-ui-text text-center mb-10">Descarrega, llegeix i guarda els documents oficials del club.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {documents.map((doc) => (
        <article class={`group relative rounded-2xl overflow-hidden shadow-soft hover:shadow-hard transition-all duration-300 hover:-translate-y-1 bg-brand-dark`}>
          <!-- Gradient -->
          <div class={`absolute inset-0 bg-gradient-to-br ${doc.color}`}></div>
          <!-- Accent top -->
          <div class="absolute top-0 left-0 right-0 h-1" style={`background-color: ${doc.accent};`}></div>

          <div class="relative p-6 flex flex-col gap-4 h-full">
            <!-- Icon + badge -->
            <div class="flex items-start justify-between">
              <span class="text-4xl">{doc.icon}</span>
              <span class="text-xs font-bold rounded-pill px-2.5 py-1 border"
                    style={`color: ${doc.accent}; border-color: ${doc.accent}40; background-color: ${doc.accent}15;`}>
                {doc.badge}
              </span>
            </div>

            <!-- Text -->
            <div class="flex-grow">
              <h3 class="text-lg font-extrabold text-white mb-2">{doc.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed">{doc.description}</p>
            </div>

            <!-- CTA -->
            <a
              href={doc.file}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold
                     bg-white/10 hover:bg-white/20 text-white border border-white/10
                     transition-all duration-200 group-hover:gap-3 focus:outline-none focus:ring-2 focus:ring-white/30"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Descarregar
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-ui-bg py-16">
    <div class="container mx-auto px-4 md:px-6 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-extrabold text-brand-dark mb-2 text-center">Preguntes freqüents</h2>
      <p class="text-ui-text text-center mb-10">Les consultes més habituals dels socis i famílies.</p>

      <div class="space-y-3" id="faq-list">
        {faqs.map((faq, i) => (
          <div class="faq-item rounded-2xl bg-white border border-brand-light/20 shadow-soft overflow-hidden">
            <button
              class="faq-btn w-full text-left px-6 py-4 flex items-center justify-between gap-4
                     font-semibold text-brand-dark hover:text-secondary-blue transition-colors
                     focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-dark/20"
              aria-expanded="false"
              data-index={i}
            >
              <span>{faq.q}</span>
              <svg class="faq-icon w-5 h-5 flex-shrink-0 text-brand-light transition-transform duration-200"
                   xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body hidden px-6 pb-5 text-ui-text text-sm leading-relaxed">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA contacte -->
  <section class="bg-brand-dark py-14">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-2xl font-extrabold text-white mb-2">Tens alguna altra pregunta?</h2>
      <p class="text-white/60 mb-8 max-w-md mx-auto">Escriu-nos i et respondrem el més aviat possible.</p>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 rounded-pill bg-brand-light text-brand-dark px-8 py-3
               font-bold hover:bg-white transition-colors shadow-lg"
      >
        Contactar amb el club
      </a>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !body.classList.contains('hidden');

      // Tanca tots
      document.querySelectorAll('.faq-body').forEach(b => b.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.style.transform = '');
      document.querySelectorAll('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

      // Obre el clicat si estava tancat
      if (!isOpen) {
        body.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
